NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/graphql
NEXT_PUBLIC_UI_TELEMETRY_ENABLED=true
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:4000/telemetry
# WalletConnect Project ID (get free at http://dashboard.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Web push notification opt-in (#661). Public VAPID key used by the browser
# to validate push subscriptions — must match the backend's VAPID_PUBLIC_KEY
# (see nftopia-backend/.env.example). Generate a pair with `npx web-push
# generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here